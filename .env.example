# AaditOS environment variables.
#
# Copy to `.env` for local development, or paste into your host's environment
# settings for production. Never commit a filled-in copy.
#
# AaditOS runs with NONE of these set: demo mode, the Wilcox calendars and the
# weather all work with no credentials at all. Each variable below unlocks one
# specific capability.

# ------------------------------------------------------------ Assistant (AI)
# Server-only. Without a key, Capture and Ask show an honest "not configured"
# state instead of generating anything.
OPENAI_API_KEY=
# A spare key on a different OpenAI account or project. When the primary is
# rate limited or out of quota the request moves here. This is what makes
# "never runs out" true; without it there is one key to run out of.
OPENAI_API_KEY_FALLBACK=
# Defaults to gpt-5.6-terra. See the note in src/server/env.ts.
OPENAI_MODEL=gpt-5.6-terra
# Tried in order after OPENAI_MODEL when it is busy or unavailable.
# Default: gpt-5.6-luna,gpt-5.6-sol
OPENAI_FALLBACK_MODELS=
# Per-response ceiling. Default 1500, hard cap 4000.
OPENAI_MAX_OUTPUT_TOKENS=
# Daily request stop for the signed-in owner. 0 (default) = none.
OPENAI_DAILY_REQUEST_CAP=
# Daily requests for a caller with no session (demo mode, strangers). Default 40.
OPENAI_GUEST_DAILY_CAP=
# Salt for the hashed `safety_identifier` sent to OpenAI. Use any long random
# string; changing it only changes the hash, never the app's behaviour.
SAFETY_IDENTIFIER_SALT=

# ------------------------------------------------------- Authentication (Supabase)
# These two are public by design and are the only variables exposed to the
# browser. Row Level Security in supabase/migrations is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only. Needed only if you extend the cron job to write to Postgres.
SUPABASE_SERVICE_ROLE_KEY=

# Password sign-in — one field on the sign-in page. Works on a school
# Chromebook, where third-party Google OAuth is blocked outright. The password
# you type is NEVER the Supabase password: the server derives a 48-character
# password per account from ACCOUNT_PASSWORD_SECRET and exchanges that for a
# session. Run `bun run passcode:provision` once after setting these (needs the
# service role key above). Rotating the secret invalidates every derived password.
# (APP_PASSCODE is accepted as an alias.)
APP_PASSWORD=
ACCOUNT_PASSWORD_SECRET=

# --------------------------------------------------------------------- GitHub
# Fine-grained personal access token, read-only, from
# https://github.com/settings/personal-access-tokens/new
#   Issues: Read · Pull requests: Read
# Feeds the Inbox: issues assigned to you, PRs waiting on your review, your open PRs.
GITHUB_TOKEN=

# ---------------------------------------------------------------------- Slack
# A Slack app (https://api.slack.com/apps) installed to the workspace, User
# Token Scopes: search:read, users:read. Paste the xoxp- user token. Read-only:
# mentions and DMs from the last week go to the Inbox.
SLACK_USER_TOKEN=

# --------------------------------------------------------------------- Notion
# Internal integration from https://www.notion.so/my-integrations. Share the
# pages you want visible with it inside Notion. Pages edited this week go to
# the Inbox. Optionally, a tasks database whose open rows go there too.
NOTION_TOKEN=
NOTION_TASKS_DATABASE_ID=

# --------------------------------------------------------------------- Vercel
# Account token from https://vercel.com/account/tokens (read scope is enough).
# Only needed when the projects live under a team.

# -------------------------------------------------------------------- Spotify
# From https://developer.spotify.com/dashboard. The refresh token is obtained
# once with the Authorization Code flow — see README → Spotify setup.

# --------------------------------------------------------------------- Google
# OAuth client from Google Cloud Console with the Calendar, Classroom and Gmail
# APIs enabled. One client serves Classroom, Calendar and Gmail; Gmail is a
# separate, read-only consent that the Integrations page asks for only when
# you press Connect Gmail. School-managed accounts may block third-party OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------- Aeries (official gradebook)
# Aeries is Santa Clara USD's student information system. There is no central
# Aeries API: each district hosts its own, and access requires an API
# certificate issued by a district Aeries administrator. Districts do not
# normally issue one to a student, so this usually needs the district's help.
# Endpoint paths differ between Aeries versions. Override only if the defaults
# return 404. `{school}`, `{student}` and `{gradebook}` are substituted.
AERIES_BASE_URL=
AERIES_CERT=
AERIES_SCHOOL_CODE=
AERIES_STUDENT_ID=
AERIES_PATH_CLASSES=
AERIES_PATH_GRADEBOOKS=
AERIES_PATH_GRADES=

# ----------------------------------------------------------------- Scheduling
# Shared secret for POST/GET /api/cron/sync. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Without it the endpoint returns 503.
CRON_SECRET=

# ------------------------------------------------------------------ Encryption
# 32+ random characters. Required before any provider refresh token is written
# to storage; without it AaditOS refuses to persist tokens rather than storing
# them in plaintext.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------- Tests
# Point Playwright at an already-running server instead of building one.
E2E_BASE_URL=
E2E_PORT=

# ------------------------------------------------------------ Notifications
# Web push, so alerts arrive when AaditOS is closed. Generate with:
#   node scripts/generate-vapid-keys.mjs
# The public key is public by design — it is embedded in every subscription.
# Without these, in-app notifications still work; only background push is off.
